VITE_SUPABASE_URL=
# Current Supabase key scheme. The legacy VITE_SUPABASE_ANON_KEY is still read
# as a fallback, so existing deployments keep working.
VITE_SUPABASE_PUBLISHABLE_KEY=
# VITE_SUPABASE_ANON_KEY=
# Optional tldraw pro license
# VITE_TLDRAW_LICENSE_KEY=

# Video conferencing deployment. Defaults to Jitsi's free public server
# (meet.jit.si), which ENFORCES its own branding — the Jitsi watermark and
# pre-join screen cannot be removed there, and its terms require the
# attribution. To show the KTIP logo instead, point at a deployment you
# control, then the interfaceConfig overrides in JitsiVideoCall.tsx apply:
#   JaaS (8x8, free tier ~25 monthly users) — https://jaas.8x8.vc
#     VITE_JITSI_DOMAIN=8x8.vc
#     VITE_JITSI_APP_ID=vpaas-magic-cookie-xxxxxxxxxxxx
#   Self-hosted Jitsi Meet
#     VITE_JITSI_DOMAIN=meet.your-domain.org
#
# IMPORTANT: whatever domain you set here must ALSO be added to the
# Permissions-Policy header in vercel.json (camera / microphone /
# display-capture / screen-wake-lock). That header lists origins allowed to
# use the camera; a domain missing from it gets "Permissions policy
# violation: camera is not allowed in this document" and the participant is
# never even prompted for access.
# VITE_JITSI_DOMAIN=
# VITE_JITSI_APP_ID=

# Elevated key — bypasses RLS. Server-side only; NEVER expose to the client.
# Used by /api/admin/*, /api/delete-account, /api/invite/send, /api/partner/*
# and the Virtual Campus routes. Set this in Vercel Environment Variables.
# Supabase dashboard: Settings -> API Keys -> secret key (sb_secret_…).
SUPABASE_SECRET_KEY=
# Deprecated service_role JWT. Still read as a fallback so un-migrated
# deployments keep working; remove once every environment sets the key above.
# SUPABASE_SERVICE_ROLE_KEY=

# ── Error monitoring (Sentry) ──────────────────────────────────────────────
# Entirely optional: with no DSN the SDK never initialises and the app behaves
# exactly as before. Session Replay is deliberately not enabled, and performance
# tracing stays off until a visitor accepts optional analytics.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=          # defaults to the Vite mode
VITE_SENTRY_RELEASE=              # defaults to VERCEL_GIT_COMMIT_SHA at build

# Server-side Sentry for the /api Edge handlers. The browser DSN can be reused.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=

# Sentry Web API read access — powers /admin/errors and the source-map upload.
# Needs the "event:read" and "project:read" scopes (Settings → Developer
# Settings → internal integration, or a personal auth token). Add "event:write"
# to resolve/ignore from the dashboard, and "event:admin" to delete.
# Server-side only: read by api/admin/sentry.ts and never bundled for the
# browser. Setting all three also enables source-map upload at build time.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
# EU-region organisations only (their DSN host contains ".de."):
# SENTRY_API_BASE_URL=https://de.sentry.io/api/0

# OpenAI API Key — server-side only (used by /api/ai-chat Vercel Edge Function)
# Set this in Vercel Environment Variables for production.
# For local development, use `vercel dev` so the /api/ route is available.
OPENAI_API_KEY=

# Outbound email — server-side only. Used by /api/invite/send and by
# /api/auth/add-alias + /api/auth/reset-alias (secondary email addresses).
# Without these, the "Invite by email" tab returns a 503 and the in-app
# invite paths keep working; secondary-email verification cannot be sent, so
# outside production the link is logged to the server console instead.
# The sending domain must be verified in Resend before delivery succeeds.
# https://resend.com/domains
RESEND_API_KEY=
# Must be an address on your verified domain.
EMAIL_FROM=KTIP <admin@oecsinnovation.org>
# Deprecated alias of EMAIL_FROM. Only read when EMAIL_FROM is unset; new
# deployments should set EMAIL_FROM and leave this blank.
# INVITE_FROM_EMAIL=

# Public origin baked into the links inside those emails — no trailing slash.
# When unset, each handler falls back to the origin the request arrived on,
# which is wrong for anything not initiated by a browser on the real domain
# (Supabase webhooks, cron jobs, Vercel preview URLs). Set it in production.
# Invalid or non-HTTP(S) values fail closed rather than sending token links to
# an unintended request origin.
# ${SITE_URL}/reset-password must also be allow-listed under Supabase
# Auth -> URL Configuration -> Redirect URLs, or GoTrue silently replaces it
# with the project's own Site URL.
SITE_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# OECS Virtual Campus SSO — server-side only
# ---------------------------------------------------------------------------
# Powers "Go to KTIP" on the Virtual Campus (api/auth/vc/callback) and the
# "Sign in with OECS Virtual Campus" button on /login (api/auth/vc/start).
# With these unset, both routes redirect to /login?vc_error=not_configured and
# nothing else in the app changes.
#
# NOTE: https://oecscampus.org/.well-known/openid-configuration currently
# returns the site's HTML login page rather than JSON — OIDC discovery is not
# deployed. Every endpoint below therefore has to be spelled out; do not
# replace them with a discovery fetch.
#
# The signing key is EC P-256 / ES256, kid `vc-oidc-1`.
VC_ISSUER=https://oecscampus.org
VC_JWKS_URL=https://oecscampus.org/api/auth/oidc/jwks
VC_CLIENT_ID=ktip-production
# Only used by the authorization-code flow (the /login button). The `vc_token`
# handoff needs no secret — it is verified against the public JWKS.
VC_CLIENT_SECRET=
# Defaults are derived from VC_ISSUER; override only if the campus moves them.
# VC_AUTHORIZE_URL=https://oecscampus.org/api/auth/oidc/authorize
# VC_TOKEN_URL=https://oecscampus.org/api/auth/oidc/token
# VC_USERINFO_URL=https://oecscampus.org/api/auth/oidc/userinfo

# Course history for the auto-populated CV. The two hosts share one identity
# provider but serve DIFFERENT catalogues (academic courses vs professional
# development modules), so both are queried and the results merged.
COMMONS_BASE_URLS=https://commons.oecscampus.org,https://oecscampus.org
# Reads any learner's enrollments by email address — a platform-wide credential.
# Server-side only, never VITE_-prefixed. Without it the CV still builds, just
# without the course section.
COMMONS_API_KEY=

# ---------------------------------------------------------------------------
# KTIP Course Catalog — server-side only (see docs/CATALOG-API.md)
# ---------------------------------------------------------------------------
# Separate API from COMMONS_* above: powers the "Courses" tab on
# /resources?tab=courses (api/ktip/catalog, api/ktip/enroll), not the CV sync.
# Platform hosts (mypd/commons/default apex) share one federated catalogue, so
# a single base URL is enough — no multi-host merge needed.
KTIP_CATALOG_BASE_URL=https://commons.oecscampus.org
# Bearer secret for POST/GET .../api/external/ktip/enrollments. Get this value
# from the Virtual Campus team — it is NOT the same value as COMMONS_API_KEY.
# Server-side only, never VITE_-prefixed. Without it, browsing the catalog
# still works; enrolling returns a 503.
MYPD_KTIP_API_KEY=

# ---------------------------------------------------------------------------
# Machine translation — server-side only (used by /api/translate)
# ---------------------------------------------------------------------------
# Powers French and Spanish for everything MEMBERS write — project summaries,
# event descriptions, grant eligibility text. The app's own UI text does not go
# through here at all: it ships pre-translated in the compiled Lingui catalogs,
# so the chrome switches language even with none of this configured.
#
# Entirely optional. With no key, /api/translate answers 200 with
# `degraded: "no_key"` and user content renders in whatever language it was
# written in. Nothing breaks and nothing is hidden.
#
# Azure AI Translator, free F0 tier: 2,000,000 characters per month, no expiry.
# Create a "Translator" resource in the Azure portal, then Keys and Endpoint.
# https://learn.microsoft.com/azure/ai-services/translator/
AZURE_TRANSLATOR_KEY=
# The resource's region, e.g. eastus. Use "global" only for a global resource —
# a regional key sent without its region is rejected with a 401.
AZURE_TRANSLATOR_REGION=global
# Override only if Azure moves it, or for a sovereign cloud.
# AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com

# "openrouter", "azure" (default) or "none" to switch translation off without
# removing keys. Azure stays configured as a fallback either way.
TRANSLATION_PROVIDER=openrouter

# OpenRouter — one key, any model. Preferred over Azure for member-written text:
# it is cheaper per chat message at these volumes, and it handles informal
# Caribbean English, emoji and mid-sentence code that a dedicated MT API mangles.
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Any model that supports structured outputs. Check current slugs and prices at
# https://openrouter.ai/models — this is the cost/quality dial, and changing it
# needs no deploy. Cheap-and-fast is the right default; translation is not a
# reasoning task.
OPENROUTER_TRANSLATE_MODEL=openai/gpt-4o-mini
# Attribution headers. Optional to the API; they are what makes spend legible
# per-app on the OpenRouter dashboard.
OPENROUTER_SITE_URL=https://ktip.oecs.int
OPENROUTER_APP_NAME=KTIP

# Characters per calendar month before the app stops calling the provider and
# falls back to source text. Deliberately under the 2M free allowance so a burst
# already in flight cannot push the account into billing. Anything already in the
# shared cache keeps rendering translated after the cap is reached — only NEW
# text falls back.
TRANSLATION_MONTHLY_CHAR_CAP=1800000

# Salt for the per-caller throttle. Reader IPs are hashed with this before being
# stored, so the rate-limit table is not an access log of who read what. Any long
# random string; changing it resets every open window, which is harmless.
TRANSLATION_IP_SALT=

# ---------------------------------------------------------------------------
# Venue video (LiveKit)
# ---------------------------------------------------------------------------
# Optional. With none of this set, venue rooms keep drawing the placeholder
# tiles AvStage has always drawn and /api/venue/room-token answers 503 — the
# venue still works, the doors still hold, nobody sees an error.
#
# Sign up at https://cloud.livekit.io and create a project. The project page
# gives you three values. Check current limits at https://livekit.com/pricing —
# on the free tier the binding constraint is downstream bandwidth, not minutes,
# which is why venue_rooms.max_publishers and the `huddle` (audio-only) camera
# mode exist.
#
# THE URL IS NOT A SECRET and is VITE_-prefixed on purpose — it ships in the
# bundle every visitor downloads, which is correct: the browser has to dial it.
VITE_LIVEKIT_URL=

# THESE TWO ARE SECRETS. Never prefix them with VITE_. Anything named VITE_* is
# compiled into the JavaScript every visitor downloads, and with this secret
# somebody could mint a token for any room in your venue.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Recording (LiveKit Egress -> S3-compatible storage)
# Only needed if any room has recording_enabled. Without these, everything else
# about video still works and /api/venue/room-recording answers 503 with
# "Recording storage is not configured".
#
# Supabase Storage is NOT an Egress target, so a bucket elsewhere is required.
# Any S3-compatible store works — Cloudflare R2 is the cheapest sane default
# (no egress fees), AWS S3 and Backblaze B2 are equally fine.
RECORDING_S3_BUCKET=
RECORDING_S3_ACCESS_KEY=
RECORDING_S3_SECRET=
# "auto" suits R2. For AWS S3 use the real region, e.g. us-east-1.
RECORDING_S3_REGION=auto
# Required for R2/B2/MinIO; leave blank for AWS S3. Setting it also turns on
# path-style addressing, which non-AWS stores need.
RECORDING_S3_ENDPOINT=

# ---------------------------------------------------------------------------
# Content moderation — the pre-publication model check (119-121)
# ---------------------------------------------------------------------------
# The deterministic Postgres trigger from 065 is the enforcement boundary and
# needs none of this. These variables control the SECOND opinion: a model call
# made when a member presses submit on long-form content, which catches what a
# word list cannot — a paraphrase, an implied threat, abuse in a dialect the
# list does not cover.
#
# Leaving MODERATION_PROVIDER unset or the key blank is a supported state, not
# a broken one. The check degrades to "allow" and the trigger carries the load
# on its own, exactly as it did before the feature existed.

# "openrouter" (default), "openai", or "none" to switch the second opinion off
# without removing keys.
MODERATION_PROVIDER=openrouter
# Reuses OPENROUTER_API_KEY above. Any model with structured outputs; this is
# the cost/quality dial and changing it needs no deploy.
OPENROUTER_MODERATION_MODEL=openai/gpt-4o-mini
# Vision model for uploaded images. Must accept image_url content parts.
OPENROUTER_VISION_MODEL=openai/gpt-4o-mini
# Only read when MODERATION_PROVIDER=openai.
# OPENAI_MODERATION_MODEL=gpt-4o-mini
