# Compiled Lingui catalogs. The .po files beside them are the source of truth
# and ARE committed; these are built from them by `npm run i18n:compile`, which
# both `npm run dev` and `npm run build` run first. Committing them would mean a
# reviewer diffing generated output and, sooner or later, a catalog that no
# longer matches its .po.
src/locales/*/messages.mjs
src/locales/*/messages.js

# Responsive image variants, generated by scripts/optimize-images.mjs (run by
# `prebuild`, so `npm run build` always produces them). Content-addressed and
# ~13 MB, derived entirely from the sources in public/hero, public/pages and
# public/grants, which ARE committed.
/public/_img/
