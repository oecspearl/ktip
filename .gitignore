*.njsproj
*.sln
*.sw?

# Environment variables
.env
.env.local
.env.production
# Credentials for the authenticated perf harness (scripts/perf/trace-route.mjs).
# A real account's password: never commit, never log. The `.env` line above does
# NOT cover this — gitignore matches that name exactly, not as a prefix.
.env.perf

# Build output
build
.output
.vercel

# Supabase
.supabase

# Local scratch notes — may contain test credentials
.info
STALE_CACHING_RESEARCH.md

# Internal documentation stays on this machine only — never push to GitHub
docs/

# Playwright MCP screenshots and snapshots
.playwright-mcp

# Compiled Lingui catalogs. The .po files beside them are the source of truth
# and ARE committed; these are built from them by `npm run i18n:compile`, which
# both `npm run dev` and `npm run build` run first. Committing them would mean a
# reviewer diffing generated output and, sooner or later, a catalog that no
# longer matches its .po.
src/locales/*/messages.mjs
src/locales/*/messages.js

# Responsive image variants, generated by scripts/optimize-images.mjs (run by
# `prebuild`, so `npm run build` always produces them). Content-addressed and
# ~13 MB, derived entirely from the sources in public/hero, public/pages,
# public/grants and public/trophies, which ARE committed.
/public/_img/

# Full-resolution artwork masters — 2048px trophy renders, ~86 MB. Far too much
# for git, but they are the only high-resolution copies, so they are kept on
# disk rather than deleted (same reasoning as scripts/optimize-brand-assets.mjs:
# anything wanting a larger mark later still has one to work from). The 512px
# WebP derived from them in public/trophies/ IS committed and is what ships.
/.masters/
