  "scripts": {
    "dev": "npm run i18n:compile && vite",
    "prebuild": "node scripts/optimize-images.mjs",
    "build": "npm run i18n:compile && tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "perf": "node scripts/perf/lighthouse.mjs",
