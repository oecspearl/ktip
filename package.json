    "perf:route": "node scripts/perf/trace-route.mjs",
    "seed:events": "node scripts/refresh-event-dates.mjs",
    "migrate": "node --env-file=.env scripts/migrate.mjs",
    "migrate:dry": "node --env-file=.env scripts/migrate.mjs --dry-run",
    "i18n:scan": "node scripts/i18n/scan.mjs",
    "i18n:harvest": "node scripts/i18n/harvest.mjs",
    "i18n:apply": "node scripts/i18n/apply.mjs",
    "i18n:check": "node scripts/i18n/check.mjs",
    "i18n:extract": "npm run i18n:harvest && lingui extract --clean",
    "i18n:translate": "node scripts/i18n/translate-catalogs.mjs",
    "i18n:compile": "lingui compile && node scripts/i18n/alias-compiled.mjs",
    "i18n": "npm run i18n:extract && npm run i18n:translate && npm run i18n:compile"
  },
