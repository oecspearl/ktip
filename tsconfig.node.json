{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "types": ["node"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  /*
   * Everything that runs on a server, not in the browser: the Vite/Vitest
   * configs, the Vercel functions under api/, and the tests that import them.
   * Those tests have to live here rather than with the app project — they pull
   * in api/_lib, which uses process.env, and tsconfig.app.json deliberately has
   * no node types.
   *
   * ALL of api/, not a hand-picked list. The list this replaced covered six
   * paths, and the routes outside it were compiled by nothing before deploy —
   * which is how two admin routes shipped calling a function they never
   * imported (ERROR-LOG, 2026-09-09). Vercel's bundler is not a type checker.
   */
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "api",
    "src/lib/__tests__"
  ]
}
