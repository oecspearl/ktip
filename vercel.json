{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' blob: https:; connect-src 'self' https://api.github.com https://*.supabase.co wss://*.supabase.co https://*.ingest.sentry.io https://*.ingest.de.sentry.io https://*.ingest.us.sentry.io https://*.livekit.cloud wss://*.livekit.cloud https://fonts.googleapis.com; frame-src 'self' blob: https://www.loom.com https://drive.google.com https://www.youtube-nocookie.com https://player.vimeo.com; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(self), display-capture=(self), screen-wake-lock=(self), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    },
    {
      "source": "/(.*\\.(?:png|jpg|jpeg|gif|ico|svg|webp|woff2?))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/test-creds(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/_img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/vision/wasm/:version/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/(index\\.html|sw\\.js|registerSW\\.js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/auth/vc/callback",
      "destination": "/api/auth/vc/callback"
    },
    {
      "source": "/auth/vc/start",
      "destination": "/api/auth/vc/start"
    },
    {
      "source": "/og/:kind(event|grant|project|org)/:id([a-z0-9-]+)\\.jpg",
      "destination": "/api/share-image?kind=:kind&id=:id"
    },
    {
      "source": "/projects/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|meta-externalagent|LinkedInBot|WhatsApp|Twitterbot|Slackbot|TelegramBot|Discordbot|Pinterest|redditbot|SkypeUriPreview|MicrosoftPreview|Embedly|Iframely).*"
        }
      ],
      "destination": "/api/share?og=project&id=:id"
    },
    {
      "source": "/events/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|meta-externalagent|LinkedInBot|WhatsApp|Twitterbot|Slackbot|TelegramBot|Discordbot|Pinterest|redditbot|SkypeUriPreview|MicrosoftPreview|Embedly|Iframely).*"
        }
      ],
      "destination": "/api/share?og=event&id=:id"
    },
    {
      "source": "/grants/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|meta-externalagent|LinkedInBot|WhatsApp|Twitterbot|Slackbot|TelegramBot|Discordbot|Pinterest|redditbot|SkypeUriPreview|MicrosoftPreview|Embedly|Iframely).*"
        }
      ],
      "destination": "/api/share?og=grant&id=:id"
    },
    {
      "source": "/org/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|meta-externalagent|LinkedInBot|WhatsApp|Twitterbot|Slackbot|TelegramBot|Discordbot|Pinterest|redditbot|SkypeUriPreview|MicrosoftPreview|Embedly|Iframely).*"
        }
      ],
      "destination": "/api/share?og=org&id=:slug"
    },
    {
      "source": "/((?!assets/|api/).*)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|meta-externalagent|LinkedInBot|WhatsApp|Twitterbot|Slackbot|TelegramBot|Discordbot|Pinterest|redditbot|SkypeUriPreview|MicrosoftPreview|Embedly|Iframely).*"
        }
      ],
      "destination": "/api/share?og=site"
    },
    {
      "source": "/((?!assets/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/kpi-snapshot",
      "schedule": "5 3 * * 1"
    },
    {
      "path": "/api/cron/purge-accounts",
      "schedule": "20 3 * * *"
    },
    {
      "path": "/api/cron/verification-expiry",
      "schedule": "40 3 * * *"
    },
    {
      "path": "/api/cron/purge-legal-archive",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/monthly-report",
      "schedule": "0 6 1 * *"
    },
    {
      "path": "/api/cron/quarterly-report",
      "schedule": "0 6 1 1,4,7,10 *"
    }
  ],
  "functions": {
    "api/share-image.ts": {
      "includeFiles": "api/_assets/**"
    }
  }
}
